{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaultur",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true},
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{"binding":"VAULTUR_DB","database_name":"vaultur","database_id":"f3cee983-d587-493b-a32f-99c98bb730df","migrations_dir":"migrations"}],
  "kv_namespaces": [{"binding":"VAULTUR_KV","id":"a38e7a02e58a46c3a6cec8f5a313d850"}],
  "durable_objects": {"bindings":[{"name":"VAULTUR_NOTIFICATIONS","class_name":"NotificationsHub"},{"name":"VAULTUR_HEAVY","class_name":"HeavyCompute"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["NotificationsHub"]},{"tag":"v2","new_sqlite_classes":["HeavyCompute"]}],
  "assets":{"directory":"./public/web-vault","binding":"VAULTUR_ASSETS","not_found_handling":"404-page","html_handling":"auto-trailing-slash","run_worker_first":["/api/*","/identity/*","/notifications/*","/icons/*","/admin","/admin/*","/events/*","/alive"]},
  "triggers":{"crons":["12 7 * * 1","*/15 * * * *"]},
  "vars":{"DOMAIN":"https://vault.thestormsmp.com","SIGNUPS_ALLOWED":"false","SIGNUPS_DOMAINS_WHITELIST":"","LOGIN_ALLOWED_EMAILS":"","SIGNUPS_VERIFY":"false","INVITATIONS_ALLOWED":"false","EMERGENCY_ACCESS_ALLOWED":"false","SENDS_ALLOWED":"true","ORG_CREATION_USERS":"all","PASSWORD_HINTS_ALLOW":"false","SHOW_PASSWORD_HINT":"false","PASSWORD_ITERATIONS":"600000","EMAIL_FROM_NAME":"Vaultur","PUSH_ENABLED":"false","PUSH_RELAY_URI":"https://push.bitwarden.com","PUSH_IDENTITY_URI":"https://identity.bitwarden.com","TRASH_AUTO_DELETE_DAYS":"30","ATTACHMENT_LIMIT_PER_USER_KB":"","SEND_LIMIT_PER_USER_KB":"","ICON_SERVICE":"internal","ICON_CACHE_TTL_SECONDS":"2592000","USER_ATTACHMENT_LIMIT":"","LOGIN_RATELIMIT_MAX_BURST":"10","LOGIN_RATELIMIT_USER_MAX_FAILURES":"5","ADMIN_SESSION_LIFETIME_MINUTES":"20"}
}